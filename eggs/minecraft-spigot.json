{
  "id": "minecraft-spigot",
  "name": "Minecraft: Spigot / CraftBukkit",
  "description": "Standard Spigot & CraftBukkit server for classic plugin compatibility (auto-installs protected server.jar & auto-starts)",
  "dockerImage": "itzg/minecraft-server:latest",
  "defaultPorts": [{ "container": 25565, "protocol": "tcp" }],
  "defaultEnv": {
    "EULA": "TRUE",
    "TYPE": "SPIGOT",
    "VERSION": "1.21.4",
    "MEMORY": "4G",
    "AUTO_START": "true"
  },
  "versions": ["1.21.4", "1.21.1", "1.20.6", "1.20.4", "1.20.1", "1.19.4", "1.18.2", "1.16.5", "1.12.2", "1.8.8"],
  "stopCommand": "stop",
  "startupCommand": "java -Xms128M -Xmx4096M -jar server.jar nogui",
  "minMemoryMB": 1024,
  "recommendedMemoryMB": 4096,
  "category": "gaming"
}
