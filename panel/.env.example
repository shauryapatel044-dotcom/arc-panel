# Arc Panel — Frontend Environment Variables
# Copy this file to .env.local and fill in your values

# Backend API URL (Next.js server-side and client-side)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Daemon WebSocket URL for real-time server stats and console
NEXT_PUBLIC_DAEMON_WS_URL=ws://localhost:8085

# Optional: NextAuth / JWT secret if you handle tokens server-side
NEXTAUTH_SECRET=change_me_to_a_strong_random_string

# Optional: Public app URL (used for redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000
