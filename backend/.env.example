# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=mysql://arcpanel:arcpassword@127.0.0.1:3306/arcpanel

# ─── JWT Secrets ─────────────────────────────────────────────────────────────
# IMPORTANT: Change these to strong random strings in production!
JWT_SECRET=change_me_in_production
JWT_REFRESH_SECRET=change_me_refresh

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ─── Daemon ──────────────────────────────────────────────────────────────────
# Default URL used when bootstrapping the local node
DAEMON_DEFAULT_URL=http://127.0.0.1:8085
# Shared secret between panel and daemon (set by install script)
DAEMON_TOKEN=will_be_set_by_install_script

# ─── Panel ───────────────────────────────────────────────────────────────────
# Public URL of the panel frontend (used for CORS)
PANEL_URL=http://localhost:8080

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# ─── Bcrypt ──────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
