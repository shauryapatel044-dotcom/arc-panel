{
  "name": "arc-panel-daemon",
  "version": "1.0.0",
  "description": "Arc Panel Node Daemon — manages Docker containers, files, and exposes REST + WebSocket API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "chokidar": "^3.6.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "dockerode": "^4.0.2",
    "ssh2": "^1.15.0",
    "unzipper": "^0.12.3",
    "ws": "^8.17.1",
    "winston": "^3.13.0",
    "yaml": "^2.4.5",
    "tar": "^7.4.0",
    "node-forge": "^1.3.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.2",
    "@types/dockerode": "^3.3.29",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.10",
    "@types/node-forge": "^1.3.11",
    "@types/ssh2": "^1.15.0",
    "@types/tar": "^6.1.13",
    "@types/unzipper": "^0.10.9",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.11",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.57.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": ["arc-panel", "daemon", "docker", "game-server"],
  "author": "Arc Panel",
  "license": "MIT"
}
