# ============================================================
# Arc Panel Daemon — Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values.
# The install script will auto-generate DAEMON_TOKEN.

# ---------------------------------------------------------------
# Security — a cryptographically-random token shared between
# the panel backend and this daemon. All REST + WebSocket
# requests must include: Authorization: Bearer <DAEMON_TOKEN>
# ---------------------------------------------------------------
DAEMON_TOKEN=will_be_generated_by_install_script

# ---------------------------------------------------------------
# Network — ports the daemon listens on
# ---------------------------------------------------------------
# REST API + WebSocket console
DAEMON_PORT=8085

# SFTP server (username = serverId, password = DAEMON_TOKEN)
SFTP_PORT=2022

# ---------------------------------------------------------------
# Storage — paths on the host machine
# ---------------------------------------------------------------
# Root directory for all server data volumes
DATA_DIR=/var/lib/arc-panel/servers

# Where compressed backup archives are stored
BACKUP_DIR=/var/lib/arc-panel/backups

# ---------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info
