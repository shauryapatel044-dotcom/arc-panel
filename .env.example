# =============================================================================
#  Arc Panel — Root Environment Configuration
#  Copy this file to .env and fill in your values.
#
#    cp .env.example .env
#
#  ⚠️  NEVER commit the .env file to version control.
#  ⚠️  Generate secrets with: openssl rand -hex 32
# =============================================================================


# ─────────────────────────────────────────────────────────────────────────────
# SERVER CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────

# The public IP or domain of this server (used for frontend API URLs)
SERVER_IP=your.server.ip.here

# Base path for bind-mount volumes (absolute path on host)
# The mariadb, servers, and backups directories will be created inside this path.
DATA_BASE_PATH=./data


# ─────────────────────────────────────────────────────────────────────────────
# DATABASE — MariaDB
# ─────────────────────────────────────────────────────────────────────────────

# Root password (only used internally by MariaDB container)
# Generate: openssl rand -hex 32
DB_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD

# Application database name
DB_NAME=arcpanel

# Application database user
DB_USER=arcpanel

# Application database password
# Generate: openssl rand -hex 24
DB_PASSWORD=CHANGE_ME_APP_DB_PASSWORD


# ─────────────────────────────────────────────────────────────────────────────
# AUTHENTICATION — JWT
# ─────────────────────────────────────────────────────────────────────────────

# Secret key for signing access tokens
# Generate: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_JWT_SECRET_AT_LEAST_64_CHARS

# Secret key for signing refresh tokens (must differ from JWT_SECRET)
# Generate: openssl rand -hex 64
JWT_REFRESH_SECRET=CHANGE_ME_JWT_REFRESH_SECRET_AT_LEAST_64_CHARS

# Token lifetimes
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d


# ─────────────────────────────────────────────────────────────────────────────
# DAEMON — Arc Panel Game Server Daemon
# ─────────────────────────────────────────────────────────────────────────────

# Shared secret between backend and daemon (must match in both services)
# Generate: openssl rand -hex 32
DAEMON_TOKEN=CHANGE_ME_DAEMON_TOKEN

# Daemon API port
DAEMON_PORT=8085

# SFTP port for game server file management
SFTP_PORT=2022

# Optional: restrict daemon binding
DAEMON_BIND=0.0.0.0
SFTP_BIND=0.0.0.0


# ─────────────────────────────────────────────────────────────────────────────
# BACKEND — Node.js API
# ─────────────────────────────────────────────────────────────────────────────

# Backend API port
BACKEND_PORT=3001
BACKEND_BIND=0.0.0.0

# Allowed CORS origins (comma-separated list of origins)
# Include the full protocol, host, and port
CORS_ORIGINS=http://your.server.ip.here:8080,http://localhost:8080

# Logging level: debug | info | warn | error
LOG_LEVEL=info


# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND — Next.js Panel
# ─────────────────────────────────────────────────────────────────────────────

# Panel web port
PANEL_PORT=8080
PANEL_BIND=0.0.0.0

# These are PUBLIC variables — they are embedded in the browser bundle.
# Use the server's public IP or domain that users will access from their browsers.

# Backend REST API URL (browser-accessible)
NEXT_PUBLIC_API_URL=http://your.server.ip.here:3001

# Daemon HTTP URL (browser-accessible, for direct stats/health)
NEXT_PUBLIC_DAEMON_URL=http://your.server.ip.here:8085

# Daemon WebSocket URL (browser-accessible, for real-time console/stats)
NEXT_PUBLIC_DAEMON_WS_URL=ws://your.server.ip.here:8085


# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — Feature Flags
# ─────────────────────────────────────────────────────────────────────────────

# Enable user registration (set to 'false' to require admin invitation)
ALLOW_REGISTRATION=true

# Maximum number of servers a regular user can create (0 = unlimited)
MAX_SERVERS_PER_USER=5

# Default server memory limit in MB (can be overridden per server)
DEFAULT_MEMORY_LIMIT_MB=1024

# Default server disk limit in MB (can be overridden per server)
DEFAULT_DISK_LIMIT_MB=10240

# Default server CPU limit in percent (100 = 1 core, 200 = 2 cores)
DEFAULT_CPU_LIMIT_PERCENT=100

# Enable automatic backups for all servers
AUTO_BACKUP_ENABLED=true

# Backup retention count (how many backups to keep per server)
BACKUP_RETENTION_COUNT=5


# ─────────────────────────────────────────────────────────────────────────────
# SMTP — Email Notifications (Optional)
# ─────────────────────────────────────────────────────────────────────────────

# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=noreply@example.com
# SMTP_PASSWORD=your_smtp_password
# SMTP_FROM="Arc Panel <noreply@example.com>"
